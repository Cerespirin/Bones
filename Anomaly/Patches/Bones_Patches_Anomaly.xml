<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Patch>
	<!-- Add EVIIIIL bones to entities -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef/race[specificMeatDef="Meat_Twisted"]/../statBases</xpath>
		<value>
			<BoneAmount>20</BoneAmount>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef/race[specificMeatDef="Meat_Twisted"]/..</xpath>
		<value>
			<li Class = "Cerespirin.Bones.BoneProductExt">
				<boneDef>Bones_Wraithbone</boneDef>
			</li>
		</value>
	</Operation>
</Patch>
